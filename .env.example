# PostgreSQL connection string (required).
DATABASE_URL=postgres://meds:CHANGE_ME@127.0.0.1:5432/meds

# Cloudflare Access (required in production unless MEDS_ACCESS_DISABLED=1).
# Team domain from Zero Trust → Settings → Custom pages, AUD from the Access application.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# Local acceptance only: skip the Access check (never set this behind a public hostname).
# MEDS_ACCESS_DISABLED=1

# Set to 0 to skip applying ./drizzle migrations at boot.
# MEDS_MIGRATE_ON_START=1
